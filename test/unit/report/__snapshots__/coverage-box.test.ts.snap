exports[`the box in report.html > snapshot: automatic checks only 1`] = `
"<section class="coverage" aria-labelledby="coverage-title">
<h2 id="coverage-title">What this report covers</h2>
<p class="check-type">Automatic checks only (no AI)</p>
<p>ShipCheck loaded your pages and checked them from the outside: hidden errors, broken links, phone screen layout, SEO and basic security. It did not sign up, log in or use any feature.</p>
<table class="cov">
<caption class="sr-only">What happened in each area</caption>
<thead class="sr-only"><tr><th scope="col">Area</th><th scope="col">Result</th></tr></thead>
<tbody><tr class="group"><th colspan="2" scope="colgroup">Using your app like a visitor (full check only)</th></tr><tr class="st-not-tested"><th scope="row">Sign-up</th><td><span class="icon" aria-hidden="true">○</span> <span class="state">Not tested: this needs the full check</span></td></tr><tr class="st-not-tested"><th scope="row">Log-in</th><td><span class="icon" aria-hidden="true">○</span> <span class="state">Not tested: this needs the full check</span></td></tr><tr class="st-not-tested"><th scope="row">Main feature</th><td><span class="icon" aria-hidden="true">○</span> <span class="state">Not tested: this needs the full check</span></td></tr><tr class="st-not-tested"><th scope="row">Forms (including wrong or missing input)</th><td><span class="icon" aria-hidden="true">○</span> <span class="state">Not tested: this needs the full check</span></td></tr><tr class="st-not-tested"><th scope="row">Using it on a phone</th><td><span class="icon" aria-hidden="true">○</span> <span class="state">Not tested: this needs the full check</span></td></tr></tbody>
<tbody><tr class="group"><th colspan="2" scope="colgroup">Automatic checks (always run)</th></tr><tr class="st-no-problems"><th scope="row">Phone screen layout</th><td><span class="icon" aria-hidden="true">✓</span> <span class="state">No problems found</span></td></tr><tr class="st-no-problems"><th scope="row">Hidden errors</th><td><span class="icon" aria-hidden="true">✓</span> <span class="state">No problems found</span></td></tr><tr class="st-no-problems"><th scope="row">Broken links</th><td><span class="icon" aria-hidden="true">✓</span> <span class="state">No problems found</span></td></tr><tr class="st-problems s-minor"><th scope="row">SEO</th><td><span class="icon" aria-hidden="true">⚠</span> <span class="state">1 problem</span></td></tr><tr class="st-no-problems"><th scope="row">Basic security</th><td><span class="icon" aria-hidden="true">✓</span> <span class="state">No problems found</span></td></tr><tr class="st-no-problems"><th scope="row">Accessibility</th><td><span class="icon" aria-hidden="true">✓</span> <span class="state">No problems found</span></td></tr></tbody>
</table>
<p class="why-differ">Automatic checks can’t find problems that only appear when someone uses the app, such as a sign-up that fails or a button that does nothing. That’s why a full check often finds more than automatic checks.</p>
<p><strong>Next step:</strong> Run the full check to test your app like a real visitor. You need a free AI key.</p>
<pre class="cmd"><code>npx @anjalipanwar/shipcheck https://myapp.example.com/</code></pre>
<p><a href="https://github.com/Anjalipanwar/shipcheck#get-a-free-ai-key" rel="noopener noreferrer">How to get a free AI key</a></p>
</section>"
`;

