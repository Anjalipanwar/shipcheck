{
  "name": "@anjalipanwar/shipcheck",
  "version": "0.1.0",
  "description": "A QA engineer's pre-launch checkup for your vibe-coded app — in one command.",
  "license": "MIT",
  "author": "Anjali Panwar",
  "type": "module",
  "bin": {
    "shipcheck": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "test:ai": "vitest run --project ai"
  },
  "keywords": [
    "qa",
    "testing",
    "ai",
    "vibe-coding",
    "playwright",
    "stagehand",
    "pre-launch"
  ],
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@browserbasehq/stagehand": "3.7.3",
    "commander": "^15.1.0",
    "open": "^11.0.4",
    "ora": "^10.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.65.0",
    "tldts": "^7.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
